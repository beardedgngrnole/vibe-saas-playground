# --- App basics ---
NEXT_PUBLIC_APP_URL=

# --- Database (SQLite by default; easy Postgres swap later) ---
# For SQLite via Prisma:
DATABASE_URL="file:./dev.db"

# --- Auth (we'll use magic link later) ---
