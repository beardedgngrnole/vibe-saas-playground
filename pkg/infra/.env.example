# --- Email (pick one; leave blank for now) ---
EMAIL_PROVIDER_API_KEY=

# --- Payments (Stripe; optional for now) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Node env ---
NODE_ENV=development

